{
  "name": "frontend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev -H 0.0.0.0 -p 3002",
    "build": "next build",
    "start": "next start -H 0.0.0.0 -p 3002",
    "lint": "eslint src tests/e2e",
    "test": "npm run test:contracts && npm run test:contract && npm run test:unit",
    "typecheck": "tsc --noEmit --incremental false",
    "test:e2e": "playwright test",
    "test:contract": "node tests/vision-contract.cjs",
    "test:unit": "vitest run",
    "test:contracts": "npm --prefix ../packages/contracts run build"
  },
  "dependencies": {
    "@volumeal/contracts": "file:../packages/contracts",
    "axios": "1.18.0",
    "clsx": "^2.1.1",
    "lucide-react": "0.468.0",
    "msw": "^2.11.3",
    "next": "16.3.5",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^2.3.0",
    "three": "^0.164.1",
    "zod": "^3.25.76",
    "zustand": "^4.5.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^20.12.7",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "^0.164.1",
    "autoprefixer": "^10.4.19",
    "axios-mock-adapter": "^2.1.0",
    "eslint": "^9.36.0",
    "postcss": "8.5.28",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "typescript-eslint": "^8.44.1",
    "vitest": "4.1.11"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
