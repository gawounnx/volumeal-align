ENV=development
# Set a long random secret locally. Never commit the real .env file.
JWT_SECRET_KEY=
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
DEV_AUTH_BYPASS=false
ONNX_USE_CUDA=false
DEPTH_MODEL_IS_METRIC=false
# ONNX_DEPTH_MODEL_PATH=/absolute/path/to/metric-depth.onnx
# ONNX_SEG_MODEL_PATH=/absolute/path/to/segmentation.onnx
# NUTRITION_DATA_PATH=/absolute/path/to/verified-food-reference.json
